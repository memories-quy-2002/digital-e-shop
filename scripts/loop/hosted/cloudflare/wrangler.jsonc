{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digital-e-loop-stage0",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "STAGE0_DB",
      "database_name": "digital-e-loop-stage0-local",
      // Local development uses Wrangler's local D1. Keep remote preview IDs separate from production.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "production": {
      // Provisioned production bindings; deploy through the protected Hosted Loop Stage 0 workflow.
      "name": "digital-e-loop-stage0-production",
      "vars": {
        // Public GitHub identifiers. Private key and webhook secret are Worker secrets.
        "GITHUB_APP_ID": "5130911",
        "GITHUB_INSTALLATION_ID": "166381027",
        "GITHUB_REPOSITORY": "memories-quy-2002/digital-e-shop",
        "GITHUB_REPOSITORY_ID": "743050379",
        "STAGE0_CHECK_RUN_NAME": "Loop Engineering Stage 0"
      },
      // Match Dashboard logging so strict deployments do not disable production diagnostics.
      "observability": {
        "logs": {
          "enabled": true
        }
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "d1_databases": [
        {
          // Use the binding for migration commands; omit local-only metadata to match Dashboard bindings.
          "binding": "STAGE0_DB",
          "database_id": "f0c7defb-62d0-4540-8c1a-3f2405a69193"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENT_QUEUE",
            "queue": "digital-e-loop-stage0-events"
          }
        ],
        "consumers": [
          {
            "queue": "digital-e-loop-stage0-events",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "digital-e-loop-stage0-dead-letter"
          }
        ]
      }
    }
  }
}
