generator client {
  provider     = "prisma-client"
  output       = "../../generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "mysql"
}

model OperationsTask {
  id                Int       @id @default(autoincrement())
  kind              String    @db.VarChar(32)
  businessKey       String    @map("business_key") @db.VarChar(191)
  payload           Json
  payloadHash       String    @map("payload_hash") @db.Char(64)
  state             String    @default("READY") @db.VarChar(24)
  dueAt             DateTime  @default(now()) @map("due_at") @db.DateTime(3)
  attempt           Int       @default(0)
  firstAttemptAt    DateTime? @map("first_attempt_at") @db.DateTime(3)
  leaseToken        String?   @map("lease_token") @db.Char(36)
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.DateTime(3)
  providerReference String?   @map("provider_reference") @db.VarChar(191)
  lastReason        String?   @map("last_reason") @db.VarChar(80)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.DateTime(3)

  @@unique([kind, businessKey], map: "uq_operations_tasks_key")
  @@index([state, dueAt, id], map: "idx_operations_tasks_due")
  @@index([state, leaseExpiresAt], map: "idx_operations_tasks_lease")
  @@map("operations_tasks")
}

model DeliveryQuote {
  id                   String @id @db.Char(36)
  fingerprint          String @db.Char(64)
  ownerHash            String @map("owner_hash") @db.Char(64)
  provider             String @db.VarChar(16)
  serviceTypeId        Int? @map("service_type_id")
  address              Json
  parcel               Json?
  pricing              Json
  originLatitude       Decimal? @map("origin_latitude") @db.Decimal(10, 7)
  originLongitude      Decimal? @map("origin_longitude") @db.Decimal(10, 7)
  destinationLatitude  Decimal? @map("destination_latitude") @db.Decimal(10, 7)
  destinationLongitude Decimal? @map("destination_longitude") @db.Decimal(10, 7)
  distanceMeters       BigInt? @map("distance_meters") @db.UnsignedBigInt
  routeGeometry        Json? @map("route_geometry")
  settingsVersion      Int? @map("settings_version") @db.UnsignedInt
  expectedDeliveryAt   DateTime? @map("expected_delivery_at") @db.DateTime(3)
  expiresAt            DateTime @map("expires_at") @db.DateTime(3)
  consumedAt           DateTime? @map("consumed_at") @db.DateTime(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([ownerHash, expiresAt], map: "idx_delivery_quotes_owner")
  @@index([expiresAt], map: "idx_delivery_quotes_expiry")
  @@map("delivery_quotes")
}

model DeliverySettings {
  id              Int @id @db.UnsignedTinyInt
  storeAddress    String? @map("store_address") @db.VarChar(255)
  storeLatitude   Decimal? @map("store_latitude") @db.Decimal(10, 7)
  storeLongitude  Decimal? @map("store_longitude") @db.Decimal(10, 7)
  fee5To20Vnd     BigInt? @map("fee_5_to_20_vnd") @db.UnsignedBigInt
  feeOver20Vnd    BigInt? @map("fee_over_20_vnd") @db.UnsignedBigInt
  routingEndpoint String? @map("routing_endpoint") @db.VarChar(2048)
  tileUrl         String? @map("tile_url") @db.VarChar(2048)
  tileAttribution String? @map("tile_attribution") @db.VarChar(512)
  version         Int @default(0) @db.UnsignedInt
  updatedById     String? @map("updated_by_id") @db.VarChar(255)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.DateTime(3)

  updatedBy User? @relation("DeliverySettingsAdmin", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("delivery_settings")
}

model DeliveryAssignment {
  id               Int @id @default(autoincrement())
  orderId          Int @map("order_id")
  employeeId       String @map("employee_id") @db.VarChar(255)
  assignedById     String @map("assigned_by_id") @db.VarChar(255)
  scheduledStartAt DateTime @map("scheduled_start_at") @db.DateTime(3)
  scheduledEndAt   DateTime @map("scheduled_end_at") @db.DateTime(3)
  status           String @default("ASSIGNED") @db.VarChar(24)
  failureReason    String? @map("failure_reason") @db.VarChar(500)
  attemptNumber    Int @default(1) @map("attempt_number") @db.UnsignedInt
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.DateTime(3)

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  employee   User @relation("DeliveryAssignmentEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy User @relation("DeliveryAssignmentAdmin", fields: [assignedById], references: [id], onDelete: Restrict)
  events     DeliveryEvent[]

  @@index([employeeId, status, scheduledStartAt, scheduledEndAt], map: "idx_delivery_assignments_employee_schedule")
  @@index([orderId, status, id], map: "idx_delivery_assignments_order_status")
  @@map("delivery_assignments")
}

model DeliveryEvent {
  id           Int @id @default(autoincrement())
  assignmentId Int @map("assignment_id")
  orderId      Int @map("order_id")
  eventType    String @map("event_type") @db.VarChar(32)
  status       String? @db.VarChar(24)
  actorId      String? @map("actor_id") @db.VarChar(255)
  publicNote   String? @map("public_note") @db.VarChar(500)
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  assignment DeliveryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor      User? @relation("DeliveryEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([assignmentId, id], map: "idx_delivery_events_assignment")
  @@index([orderId, id], map: "idx_delivery_events_order")
  @@map("delivery_events")
}

model SandboxCarrierShipment {
  clientReference String @id @map("client_reference") @db.VarChar(50)
  providerOrderCode String @unique @map("provider_order_code") @db.VarChar(100)
  inputHash String @map("input_hash") @db.Char(64)
  snapshot Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  @@map("sandbox_carrier_shipments")
}

model User {
  financialEvidenceUploads FinancialEvidence[]
  codSettlementEvents CodSettlementEvent[]
  manualRefundOperations ManualRefundOperation[]
  paymentAttemptRefunds PaymentAttemptRefund[] @relation("PaymentAttemptRefundActor")
  transactionalEmails TransactionalEmail[] @relation("TransactionalEmailAdmin")
  id                         String    @id @db.VarChar(255)
  username                   String    @db.VarChar(16)
  email                      String    @db.VarChar(255)
  password                   String    @db.VarChar(255)
  role                       String    @db.VarChar(16)
  token                      String    @db.Text
  authProvider               String?   @map("auth_provider") @db.VarChar(32)
  providerUserId             String?   @map("provider_user_id") @db.VarChar(255)
  emailVerifiedAt            DateTime? @map("email_verified_at") @db.DateTime(0)
  emailVerificationTokenHash String?   @map("email_verification_token_hash") @db.Char(64)
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at") @db.DateTime(0)
  emailVerificationSentAt    DateTime? @map("email_verification_sent_at") @db.DateTime(0)
  passwordResetTokenHash     String?   @map("password_reset_token_hash") @db.Char(64)
  passwordResetExpiresAt     DateTime? @map("password_reset_expires_at") @db.DateTime(0)
  pendingEmail               String?   @map("pending_email") @db.VarChar(255)
  emailChangeTokenHash       String?   @map("email_change_token_hash") @db.Char(64)
  emailChangeExpiresAt       DateTime? @map("email_change_expires_at") @db.DateTime(0)
  firstName                  String?   @map("first_name") @db.Text
  lastName                   String?   @map("last_name") @db.Text
  status                     String    @default("Active") @db.VarChar(20)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  lastLogin                  DateTime  @default(now()) @map("last_login") @db.DateTime(0)

  orders                    Order[]
  carts                     Cart[]
  reviews                   Review[]
  pendingCheckouts          PendingCheckout[]
  supportTickets            SupportTicket[]
  afterSalesRequests        AfterSalesRequest[]        @relation("AfterSalesRequestCustomer")
  afterSalesEvents          AfterSalesEvent[]          @relation("AfterSalesEventActor")
  marketingSubscriptions    MarketingSubscription[]
  wishlists                 Wishlist[]
  productAlertSubscriptions ProductAlertSubscription[]
  loyaltyAccount            LoyaltyAccount?
  loyaltyLedger             LoyaltyLedger[]
  loyaltyVouchers           LoyaltyVoucher[]
  deliverySettingsUpdates    DeliverySettings[] @relation("DeliverySettingsAdmin")
  deliveryAssignments        DeliveryAssignment[] @relation("DeliveryAssignmentEmployee")
  deliveryAssignmentsCreated DeliveryAssignment[] @relation("DeliveryAssignmentAdmin")
  deliveryEvents             DeliveryEvent[] @relation("DeliveryEventActor")

  @@map("users")
}

model MarketingSubscription {
  id                   Int       @id @default(autoincrement())
  email                String    @unique(map: "uq_marketing_subscriptions_email") @db.VarChar(255)
  status               String    @default("ACTIVE") @db.VarChar(20)
  unsubscribeTokenHash String?   @unique(map: "uq_marketing_subscriptions_unsubscribe_token_hash") @map("unsubscribe_token_hash") @db.Char(64)
  source               String    @default("footer") @db.VarChar(40)
  userId               String?   @map("user_id") @db.VarChar(255)
  subscribedAt         DateTime  @default(now()) @map("subscribed_at") @db.DateTime(0)
  unsubscribedAt       DateTime? @map("unsubscribed_at") @db.DateTime(0)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, subscribedAt], map: "marketing_subscriptions_status_subscribed_idx")
  @@index([userId], map: "marketing_subscriptions_user_id_idx")
  @@map("marketing_subscriptions")
}

model AuthSession {
  id               Int       @id @default(autoincrement())
  userId           String    @map("user_id") @db.VarChar(255)
  sessionStart     DateTime  @default(now()) @map("session_start") @db.DateTime(0)
  sessionEnd       DateTime? @map("session_end") @db.DateTime(0)
  refreshTokenHash String?   @map("refresh_token_hash") @db.Char(64)
  refreshExpiresAt DateTime? @map("refresh_expires_at") @db.DateTime(0)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(0)
  lastUsedAt       DateTime? @map("last_used_at") @db.DateTime(0)

  @@index([userId, revokedAt, refreshExpiresAt], map: "customer_sessions_user_active_idx")
  @@map("customer_sessions")
}

model CustomerAddress {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id") @db.VarChar(255)
  label         String   @default("Shipping address") @db.VarChar(80)
  recipientName String?  @map("recipient_name") @db.VarChar(160)
  phoneNumber   String?  @map("phone_number") @db.VarChar(40)
  addressLine   String   @map("address_line") @db.VarChar(255)
  city          String?  @db.VarChar(120)
  country       String?  @db.VarChar(120)
  provinceCode  String?  @map("province_code") @db.VarChar(32)
  provinceName  String?  @map("province_name") @db.VarChar(120)
  wardCode      String?  @map("ward_code") @db.VarChar(32)
  wardName      String?  @map("ward_name") @db.VarChar(120)
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  isDefault     Boolean  @default(false) @map("is_default") @db.TinyInt
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  @@index([userId], map: "customer_addresses_user_id_idx")
  @@map("customer_addresses")
}

model CustomerNotification {
  id           Int       @id @default(autoincrement())
  userId       String    @map("user_id") @db.VarChar(255)
  type         String    @default("order") @db.VarChar(40)
  title        String    @db.VarChar(160)
  message      String    @db.VarChar(500)
  link         String?   @db.VarChar(255)
  metadata     Json?
  alertEventId Int?      @map("alert_event_id")
  readAt       DateTime? @map("read_at") @db.DateTime(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  @@index([userId], map: "customer_notifications_user_id_idx")
  @@index([createdAt], map: "customer_notifications_created_at_idx")
  @@map("customer_notifications")
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(255)
  products Product[]

  @@map("brands")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(255)
  products Product[]

  @@map("categories")
}

model Wishlist {
  id        Int    @id @default(autoincrement())
  userId    String @map("user_id") @db.VarChar(255)
  productId Int    @map("product_id")

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_wishlist_user_id")
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_wishlist_product_id")

  @@unique([userId, productId], map: "uq_wishlist_user_id_product_id")
  @@index([productId], map: "FK_WishlistProduct")
  @@index([userId, productId], map: "idx_wishlist_user_product")
  @@map("wishlist")
}

model Product {
  parcelGrams            Int? @map("parcel_grams")
  parcelLengthCm         Int? @map("parcel_length_cm")
  parcelWidthCm          Int? @map("parcel_width_cm")
  parcelHeightCm         Int? @map("parcel_height_cm")
  id                     Int      @id @default(autoincrement())
  name                   String   @db.VarChar(255)
  description            String   @default("No description available") @db.VarChar(255)
  mainImage              String?  @map("main_image") @db.VarChar(255)
  sku                    String   @unique(map: "uq_products_sku") @db.VarChar(64)
  manufacturerPartNumber String?  @map("manufacturer_part_number") @db.VarChar(128)
  warrantyMonths         Int?     @map("warranty_months")
  categoryId             Int      @map("category_id")
  brandId                Int      @map("brand_id")
  specifications         String?  @db.Text
  price                  Decimal  @db.Decimal(10, 2)
  salePrice              Decimal? @map("sale_price") @db.Decimal(10, 2)
  stock                  Int      @default(0)
  createdAt              DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  brand                     Brand                      @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_products_brand_id_brands")
  category                  Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_products_category_id_categories")
  reviews                   Review[]
  cartItems                 CartItem[]
  orderItems                OrderItem[]
  inventoryReservations     InventoryReservation[]
  attributes                ProductAttribute[]
  guestCartItems            GuestCartItem[]
  wishlists                 Wishlist[]
  productAlertSubscriptions ProductAlertSubscription[]
  productAlertEvents        ProductAlertEvent[]

  @@index([categoryId, brandId, id], map: "idx_products_category_brand_rating")
  @@index([brandId], map: "idx_products_brand")
  @@index([categoryId], map: "idx_products_category")
  @@index([manufacturerPartNumber], map: "products_mpn_idx")
  @@map("products")
}

model ProductAlertSubscription {
  id                 Int      @id @default(autoincrement())
  userId             String   @map("user_id") @db.VarChar(255)
  productId          Int      @map("product_id")
  priceDropEnabled   Boolean  @default(false) @map("price_drop_enabled") @db.TinyInt
  backInStockEnabled Boolean  @default(false) @map("back_in_stock_enabled") @db.TinyInt
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId], map: "uq_product_alert_subscriptions_user_product")
  @@index([productId], map: "product_alert_subscriptions_product_idx")
  @@map("product_alert_subscriptions")
}

model ProductAlertEvent {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  alertType     String   @map("alert_type") @db.VarChar(24)
  previousPrice Decimal  @map("previous_price") @db.Decimal(10, 2)
  currentPrice  Decimal  @map("current_price") @db.Decimal(10, 2)
  previousStock Int      @map("previous_stock")
  currentStock  Int      @map("current_stock")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, alertType, createdAt], map: "product_alert_events_product_type_created_idx")
  @@map("product_alert_events")
}

model ProductAttribute {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  attributeKey String   @map("attribute_key") @db.VarChar(80)
  label        String   @db.VarChar(120)
  valueType    String   @map("value_type") @db.VarChar(16)
  textValue    String?  @map("text_value") @db.VarChar(255)
  numberValue  Decimal? @map("number_value") @db.Decimal(18, 4)
  unit         String?  @db.VarChar(32)
  filterable   Boolean  @default(true) @db.TinyInt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeKey], map: "uq_product_attributes_product_key")
  @@index([attributeKey, textValue], map: "product_attributes_text_filter_idx")
  @@index([attributeKey, numberValue], map: "product_attributes_number_filter_idx")
  @@map("product_attributes")
}

model InventoryMovement {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  orderId        Int?     @map("order_id")
  movementType   String   @map("movement_type") @db.VarChar(40)
  quantityChange Int      @map("quantity_change")
  stockBefore    Int?     @map("stock_before")
  stockAfter     Int?     @map("stock_after")
  note           String?  @db.VarChar(255)
  actorId        String?  @map("actor_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([productId], map: "inventory_movements_product_id_idx")
  @@index([createdAt], map: "inventory_movements_created_at_idx")
  @@map("inventory_movements")
}

model OrderStatusEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  status    Int
  label     String   @db.VarChar(80)
  note      String?  @db.VarChar(255)
  actorId   String?  @map("actor_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([orderId], map: "order_status_events_order_id_idx")
  @@index([createdAt], map: "order_status_events_created_at_idx")
  @@map("order_status_events")
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(255)
  productId  Int      @map("product_id")
  rating     Int
  reviewText String?  @map("review_text") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("reviews")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  done      Int      @default(0) @db.TinyInt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId], map: "uq_cart_items_carts_id_products_id")
  @@map("cart_items")
}

model GuestCart {
  id          String    @id @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.DateTime(0)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.DateTime(0)
  convertedAt DateTime? @map("converted_at") @db.DateTime(0)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(0)

  items GuestCartItem[]

  @@index([expiresAt], map: "guest_carts_expires_idx")
  @@index([convertedAt, updatedAt], map: "guest_carts_conversion_updated_idx")
  @@map("guest_carts")
}

model GuestCartItem {
  id          Int      @id @default(autoincrement())
  guestCartId String   @map("guest_cart_id") @db.Char(36)
  productId   Int      @map("product_id")
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  guestCart GuestCart @relation(fields: [guestCartId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([guestCartId, productId], map: "uq_guest_cart_items_cart_product")
  @@index([productId], map: "guest_cart_items_product_idx")
  @@map("guest_cart_items")
}

model Discount {
  id              Int       @id @default(autoincrement())
  discountCode    String    @map("discount_code") @db.VarChar(50)
  description     String?   @db.Text
  discountPercent Decimal   @map("discount_percent") @db.Decimal(5, 2)
  active          Boolean   @default(true) @db.TinyInt
  minOrderValue   Decimal   @default(0) @map("min_order_value") @db.Decimal(10, 2)
  startsAt        DateTime? @map("starts_at") @db.DateTime(0)
  expiresAt       DateTime? @map("expires_at") @db.DateTime(0)
  usageLimit      Int?      @map("usage_limit")
  loyaltyPointsCost Int?    @map("loyalty_points_cost")

  redemptions      DiscountRedemption[]
  pendingCheckouts PendingCheckout[]
  loyaltyVouchers  LoyaltyVoucher[]

  @@unique([discountCode], map: "uq_discounts_code")
  @@map("discounts")
}

model Shipment {
  id                 Int @id @default(autoincrement())
  orderId            Int @unique(map: "uq_shipment_order") @map("order_id")
  state              String @default("UNFULFILLED") @db.VarChar(24)
  provider           String @db.VarChar(16)
  clientReference    String @unique(map: "uq_shipment_client") @map("client_reference") @db.VarChar(50)
  providerOrderCode  String? @map("provider_order_code") @db.VarChar(100)
  expectedCodVnd     BigInt @map("expected_cod_vnd") @db.UnsignedBigInt
  actualFeeVnd       BigInt? @map("actual_fee_vnd") @db.UnsignedBigInt
  expectedDeliveryAt DateTime? @map("expected_delivery_at") @db.DateTime(3)
  deliveredAt        DateTime? @map("delivered_at") @db.DateTime(3)
  providerUpdatedAt  DateTime? @map("provider_updated_at") @db.DateTime(3)
  stockReceivedAt    DateTime? @map("stock_received_at") @db.DateTime(3)
  sandbox            Boolean @default(false)
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.DateTime(3)
  order              Order @relation(fields: [orderId], references: [id], map: "fk_shipment_order")
  events             ShipmentEvent[]

  @@unique([provider, providerOrderCode], map: "uq_shipment_provider_order")
  @@map("shipments")
}

model ShipmentEvent {
  id               Int @id @default(autoincrement())
  shipmentId       Int @map("shipment_id")
  state            String @db.VarChar(24)
  actorId          String? @map("actor_id") @db.VarChar(255)
  publicNote       String @map("public_note") @db.VarChar(255)
  providerEventKey String? @unique(map: "uq_shipment_provider_event") @map("provider_event_key") @db.Char(64)
  providerPayload  Json? @map("provider_payload")
  processedAt      DateTime? @map("processed_at") @db.DateTime(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  shipment         Shipment @relation(fields: [shipmentId], references: [id], map: "fk_shipment_event")

  @@index([shipmentId, id], map: "idx_shipment_events")
  @@map("shipment_events")
}

model Order {
  contactSnapshot Json? @map("contact_snapshot")
  codSettlement CodSettlement?
  shipment               Shipment?
  pricingSnapshot        Json? @map("pricing_snapshot")
  deliverySnapshot       Json? @map("delivery_snapshot")
  id                      Int       @id @default(autoincrement())
  userId                  String?   @map("user_id") @db.VarChar(255)
  guestEmail              String?   @map("guest_email") @db.VarChar(255)
  guestName               String?   @map("guest_name") @db.VarChar(160)
  guestPhone              String?   @map("guest_phone") @db.VarChar(40)
  guestOrderTokenHash     String?   @unique(map: "uq_orders_guest_order_token_hash") @map("guest_order_token_hash") @db.Char(64)
  totalPrice              Decimal   @map("total_price") @db.Decimal(11, 2)
  discount                Decimal   @default(0) @db.Decimal(11, 2)
  loyaltyPointsRedeemed   Int       @default(0) @map("loyalty_points_redeemed")
  loyaltyDiscount         Decimal   @default(0) @map("loyalty_discount") @db.Decimal(11, 2)
  shippingAddress         String    @map("shipping_address") @db.Text
  paymentMethod           String    @default("cash") @map("payment_method") @db.VarChar(32)
  stripeCheckoutSessionId String?   @unique(map: "uq_orders_stripe_checkout_session") @map("stripe_checkout_session_id") @db.VarChar(255)
  stripePaymentIntentId   String?   @map("stripe_payment_intent_id") @db.VarChar(255)
  dateAdded               DateTime  @default(now()) @map("date_added") @db.DateTime(0)
  deliveredAt             DateTime? @map("delivered_at") @db.DateTime(0)
  status                  Int       @default(0)
  currency                String    @default("VND") @db.Char(3)
  inventoryRestoredAt     DateTime? @map("inventory_restored_at") @db.DateTime(0)
  cancellationReason      String?   @map("cancellation_reason") @db.Text

  user                User?                @relation(fields: [userId], references: [id])
  items               OrderItem[]
  discountRedemptions DiscountRedemption[]
  payments            OrderPayment[]
  paymentAttempt       PaymentAttempt?
  supportTickets      SupportTicket[]
  afterSalesRequests  AfterSalesRequest[]
  loyaltyLedger       LoyaltyLedger[]
  loyaltyVoucher      LoyaltyVoucher?
  deliveryAssignments DeliveryAssignment[]
  deliveryEvents      DeliveryEvent[]

  @@index([guestEmail], map: "idx_orders_guest_email")
  @@index([status, dateAdded, id], map: "orders_admin_queue_idx")
  @@map("orders")
}

model PendingCheckout {
  contactSnapshot Json? @map("contact_snapshot")
  pricingSnapshot        Json? @map("pricing_snapshot")
  deliverySnapshot       Json? @map("delivery_snapshot")
  id                  Int       @id @default(autoincrement())
  stripeSessionId     String?   @unique(map: "uq_pending_checkouts_session") @map("stripe_session_id") @db.VarChar(255)
  paymentProvider     String?   @map("payment_provider") @db.VarChar(32)
  providerReference   String?   @map("provider_reference") @db.VarChar(255)
  providerOrderCode   BigInt?   @map("provider_order_code")
  paymentAmount       Decimal?  @map("payment_amount") @db.Decimal(14, 2)
  paymentCurrency     String?   @map("payment_currency") @db.Char(3)
  paymentFxRate       Decimal   @default(1) @map("payment_fx_rate") @db.Decimal(18, 6)
  reservationToken    String    @unique(map: "uq_pending_checkouts_reservation_token") @map("reservation_token") @db.Char(36)
  userId              String?   @map("user_id") @db.VarChar(255)
  guestEmail          String?   @map("guest_email") @db.VarChar(255)
  guestName           String?   @map("guest_name") @db.VarChar(160)
  guestPhone          String?   @map("guest_phone") @db.VarChar(40)
  guestOrderTokenHash String?   @unique(map: "uq_pending_checkouts_guest_order_token_hash") @map("guest_order_token_hash") @db.Char(64)
  cartJson            String    @map("cart_json") @db.Text
  totalPrice          Decimal   @map("total_price") @db.Decimal(11, 2)
  discount            Decimal   @default(0) @db.Decimal(11, 2)
  loyaltyPointsRedeemed Int     @default(0) @map("loyalty_points_redeemed")
  loyaltyDiscount     Decimal   @default(0) @map("loyalty_discount") @db.Decimal(11, 2)
  shippingAddress     String    @map("shipping_address") @db.Text
  status              String    @default("PENDING") @db.VarChar(20)
  expiresAt           DateTime  @map("expires_at") @db.DateTime(0)
  discountId          Int?      @map("discount_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  consumedAt          DateTime? @map("consumed_at") @db.DateTime(0)

  user                   User?                          @relation(fields: [userId], references: [id])
  promotion              Discount?                      @relation(fields: [discountId], references: [id])
  inventoryReservations  InventoryReservation[]
  discountRedemptions    DiscountRedemption[]
  reconciliationAttempts PaymentReconciliationAttempt[]
  paymentAttempt         PaymentAttempt?
  loyaltyVoucher         LoyaltyVoucher?
  loyaltyLedger          LoyaltyLedger[]

  @@unique([paymentProvider, providerReference], map: "uq_pending_checkouts_provider_reference")
  @@unique([paymentProvider, providerOrderCode], map: "uq_pending_checkouts_provider_order_code")
  @@index([status, expiresAt], map: "pending_checkouts_status_expiry_idx")
  @@index([guestEmail], map: "idx_pending_checkouts_guest_email")
  @@map("pending_checkouts")
}

model LoyaltyAccount {
  userId        String   @id @map("user_id") @db.VarChar(255)
  balancePoints Int      @default(0) @map("balance_points")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  user          User     @relation(fields: [userId], references: [id])

  @@map("loyalty_accounts")
}

model LoyaltyVoucher {
  id                Int       @id @default(autoincrement())
  userId            String    @map("user_id") @db.VarChar(255)
  promotionId       Int       @map("promotion_id")
  voucherCode       String    @unique(map: "uq_loyalty_voucher_code") @map("voucher_code") @db.VarChar(64)
  pointsCost        Int       @map("points_cost")
  status            String    @default("AVAILABLE") @db.VarChar(16)
  pendingCheckoutId Int?      @unique(map: "uq_loyalty_voucher_checkout") @map("pending_checkout_id")
  orderId           Int?      @unique(map: "uq_loyalty_voucher_order") @map("order_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  redeemedAt        DateTime? @map("redeemed_at") @db.DateTime(3)
  user              User      @relation(fields: [userId], references: [id])
  promotion         Discount  @relation(fields: [promotionId], references: [id])
  pendingCheckout   PendingCheckout? @relation(fields: [pendingCheckoutId], references: [id])
  order             Order?    @relation(fields: [orderId], references: [id])
  ledgerEntries     LoyaltyLedger[]

  @@index([userId, status, id], map: "loyalty_vouchers_user_status_idx")
  @@index([promotionId, status], map: "loyalty_vouchers_promotion_status_idx")
  @@map("loyalty_vouchers")
}

model LoyaltyLedger {
  id                BigInt    @id @default(autoincrement())
  userId            String    @map("user_id") @db.VarChar(255)
  orderId           Int?      @map("order_id")
  voucherId         Int?      @map("voucher_id")
  pendingCheckoutId Int?      @map("pending_checkout_id")
  entryType         String    @map("entry_type") @db.VarChar(32)
  pointsDelta       Int       @map("points_delta")
  amountVnd         BigInt?   @map("amount_vnd") @db.UnsignedBigInt
  eventKey          String    @unique(map: "uq_loyalty_ledger_event_key") @map("event_key") @db.VarChar(191)
  description       String    @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user              User      @relation(fields: [userId], references: [id])
  order             Order?    @relation(fields: [orderId], references: [id])
  voucher           LoyaltyVoucher? @relation(fields: [voucherId], references: [id])
  pendingCheckout   PendingCheckout? @relation(fields: [pendingCheckoutId], references: [id])

  @@index([userId, id], map: "loyalty_ledger_user_created_idx")
  @@index([orderId, entryType], map: "loyalty_ledger_order_idx")
  @@map("loyalty_ledger")
}

model InventoryReservation {
  id                Int      @id @default(autoincrement())
  pendingCheckoutId Int      @map("pending_checkout_id")
  productId         Int      @map("product_id")
  quantity          Int
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)

  pendingCheckout PendingCheckout @relation(fields: [pendingCheckoutId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])

  @@unique([pendingCheckoutId, productId], map: "uq_inventory_reservation_checkout_product")
  @@index([productId], map: "inventory_reservations_product_idx")
  @@map("inventory_reservations")
}

model DiscountRedemption {
  id                Int       @id @default(autoincrement())
  discountId        Int       @map("discount_id")
  pendingCheckoutId Int?      @unique(map: "uq_discount_redemptions_pending_checkout") @map("pending_checkout_id")
  orderId           Int?      @unique(map: "uq_discount_redemptions_order") @map("order_id")
  userId            String?   @map("user_id") @db.VarChar(255)
  status            String    @db.VarChar(20)
  expiresAt         DateTime? @map("expires_at") @db.DateTime(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  consumedAt        DateTime? @map("consumed_at") @db.DateTime(0)

  discount        Discount         @relation(fields: [discountId], references: [id])
  pendingCheckout PendingCheckout? @relation(fields: [pendingCheckoutId], references: [id])
  order           Order?           @relation(fields: [orderId], references: [id])

  @@index([discountId, status, expiresAt], map: "discount_redemptions_quota_idx")
  @@map("discount_redemptions")
}

model OrderItem {
  manualRefundUnits ManualRefundUnit[]
  id                     Int      @id @default(autoincrement())
  orderId                Int      @map("order_id")
  productId              Int      @map("product_id")
  quantity               Int
  totalPrice             Decimal  @default(0) @map("total_price") @db.Decimal(11, 2)
  skuSnapshot            String?  @map("sku_snapshot") @db.VarChar(64)
  productNameSnapshot    String?  @map("product_name_snapshot") @db.VarChar(255)
  imageSnapshot          String?  @map("image_snapshot") @db.VarChar(255)
  unitPriceSnapshot      Decimal? @map("unit_price_snapshot") @db.Decimal(11, 2)
  brandSnapshot          String?  @map("brand_snapshot") @db.VarChar(255)
  categorySnapshot       String?  @map("category_snapshot") @db.VarChar(255)
  warrantyMonthsSnapshot Int?     @map("warranty_months_snapshot")
  specificationsSnapshot Json?    @map("specifications_snapshot")

  order           Order            @relation(fields: [orderId], references: [id])
  product         Product          @relation(fields: [productId], references: [id])
  afterSalesItems AfterSalesItem[]

  @@unique([orderId, productId], map: "uq_order_items_order_id_product_id")
  @@map("order_items")
}

model OrderPayment {
  manualRefundOperations ManualRefundOperation[]
  id                      Int       @id @default(autoincrement())
  orderId                 Int       @map("order_id")
  provider                String    @db.VarChar(32)
  status                  String    @db.VarChar(24)
  providerReference       String?   @map("provider_reference") @db.VarChar(255)
  providerPaymentId       String?   @map("provider_payment_id") @db.VarChar(255)
  idempotencyKey          String    @unique(map: "uq_order_payments_idempotency") @map("idempotency_key") @db.VarChar(128)
  baseAmount              Decimal   @map("base_amount") @db.Decimal(11, 2)
  baseCurrency            String    @default("VND") @map("base_currency") @db.Char(3)
  amount                  Decimal   @db.Decimal(14, 2)
  currency                String    @db.Char(3)
  fxRate                  Decimal   @default(1) @map("fx_rate") @db.Decimal(18, 6)
  paidAt                  DateTime? @map("paid_at") @db.DateTime(0)
  refundedAmount          Decimal   @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  refundedAt              DateTime? @map("refunded_at") @db.DateTime(0)
  refundReference         String?   @map("refund_reference") @db.VarChar(255)
  simulated               Boolean   @default(false) @db.TinyInt
  createdAt               DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.DateTime(0)
  reconciliationStatus    String    @default("PENDING") @map("reconciliation_status") @db.VarChar(24)
  providerStatus          String?   @map("provider_status") @db.VarChar(32)
  lastReconciledAt        DateTime? @map("last_reconciled_at") @db.DateTime(0)
  lastReconciliationError String?   @map("last_reconciliation_error") @db.Text

  order                  Order                          @relation(fields: [orderId], references: [id])
  reconciliationAttempts PaymentReconciliationAttempt[]

  @@index([orderId, status], map: "order_payments_order_status_idx")
  @@index([provider, providerReference], map: "order_payments_provider_reference_idx")
  @@index([reconciliationStatus, lastReconciledAt], map: "order_payments_reconciliation_idx")
  @@map("order_payments")
}

model PaymentWebhookEvent {
  id                Int       @id @default(autoincrement())
  provider          String    @db.VarChar(32)
  eventKey          String    @map("event_key") @db.VarChar(255)
  eventType         String    @map("event_type") @db.VarChar(64)
  payloadHash       String    @map("payload_hash") @db.Char(64)
  normalizedPayload Json      @map("normalized_payload")
  orderCode         BigInt?   @map("order_code")
  paymentLinkId     String?   @map("payment_link_id") @db.VarChar(255)
  amount            Decimal?  @db.Decimal(14, 0)
  currency          String?   @db.Char(3)
  status            String    @default("RECEIVED") @db.VarChar(24)
  attemptCount      Int       @default(0) @map("attempt_count")
  lastError         String?   @map("last_error") @db.Text
  receivedAt        DateTime  @default(now()) @map("received_at") @db.DateTime(0)
  processedAt       DateTime? @map("processed_at") @db.DateTime(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.DateTime(0)

  @@unique([provider, eventKey], map: "payment_webhook_events_provider_key")
  @@index([status, receivedAt], map: "payment_webhook_events_status_received_idx")
  @@index([provider, orderCode], map: "payment_webhook_events_provider_order_idx")
  @@map("payment_webhook_events")
}

model PaymentReconciliationAttempt {
  id                Int      @id @default(autoincrement())
  provider          String   @db.VarChar(32)
  pendingCheckoutId Int?     @map("pending_checkout_id")
  orderPaymentId    Int?     @map("order_payment_id")
  requestedBy       String?  @map("requested_by") @db.VarChar(255)
  outcome           String   @db.VarChar(24)
  localStatus       String?  @map("local_status") @db.VarChar(24)
  providerStatus    String?  @map("provider_status") @db.VarChar(32)
  expectedAmount    Decimal? @map("expected_amount") @db.Decimal(14, 0)
  providerAmount    Decimal? @map("provider_amount") @db.Decimal(14, 0)
  expectedCurrency  String?  @map("expected_currency") @db.Char(3)
  providerCurrency  String?  @map("provider_currency") @db.Char(3)
  providerReference String?  @map("provider_reference") @db.VarChar(255)
  mismatchReason    String?  @map("mismatch_reason") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)

  pendingCheckout PendingCheckout? @relation(fields: [pendingCheckoutId], references: [id])
  orderPayment    OrderPayment?    @relation(fields: [orderPaymentId], references: [id])

  @@index([pendingCheckoutId], map: "payment_reconciliation_attempts_pending_idx")
  @@index([orderPaymentId], map: "payment_reconciliation_attempts_payment_idx")
  @@index([outcome, createdAt], map: "payment_reconciliation_attempts_outcome_idx")
  @@map("payment_reconciliation_attempts")
}

model PaymentAttempt {
  id                       String   @id @db.Char(36)
  ownerScope               String   @map("owner_scope") @db.VarChar(320)
  idempotencyKeyHash       String   @map("idempotency_key_hash") @db.Char(64)
  requestHash              String   @map("request_hash") @db.Char(64)
  snapshotHash             String   @map("snapshot_hash") @db.Char(64)
  pendingCheckoutId        Int      @unique(map: "uq_payment_attempts_pending_checkout") @map("pending_checkout_id")
  provider                 String   @db.VarChar(32)
  providerOrderCode        BigInt   @map("provider_order_code") @db.UnsignedBigInt
  providerLinkId           String?  @map("provider_link_id") @db.VarChar(255)
  providerLinkUrl          String?  @map("provider_link_url") @db.Text
  expectedAmountVnd        BigInt   @map("expected_amount_vnd") @db.UnsignedBigInt
  verifiedReceivedAmountVnd BigInt  @default(0) @map("verified_received_amount_vnd") @db.UnsignedBigInt
  currency                 String   @default("VND") @db.Char(3)
  paymentState             String   @default("PENDING") @map("payment_state") @db.VarChar(24)
  orderState               String   @default("NOT_CREATED") @map("order_state") @db.VarChar(24)
  resolutionState          String   @default("NONE") @map("resolution_state") @db.VarChar(24)
  orderId                  Int?     @unique(map: "uq_payment_attempts_order") @map("order_id")
  displaySnapshot          Json     @map("display_snapshot")
  expiresAt                DateTime @map("expires_at") @db.DateTime(3)
  createLeaseToken         String?  @map("create_lease_token") @db.Char(36)
  createLeaseUntil         DateTime? @map("create_lease_until") @db.DateTime(3)
  lastCheckedAt            DateTime? @map("last_checked_at") @db.DateTime(3)
  retryAfterSeconds        Int?     @map("retry_after_seconds") @db.UnsignedInt
  cancelRequestedAt        DateTime? @map("cancel_requested_at") @db.DateTime(3)
  reconcileRequestedAt     DateTime? @map("reconcile_requested_at") @db.DateTime(3)
  createdAt                DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime @default(now()) @map("updated_at") @db.DateTime(3)

  pendingCheckout PendingCheckout          @relation(fields: [pendingCheckoutId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order           Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  observations    PaymentAttemptObservation[]
  refunds         PaymentAttemptRefund[]

  @@unique([ownerScope, idempotencyKeyHash], map: "uq_payment_attempts_owner_idempotency")
  @@unique([provider, providerOrderCode], map: "uq_payment_attempts_provider_order_code")
  @@unique([provider, providerLinkId], map: "uq_payment_attempts_provider_link")
  @@index([paymentState, expiresAt], map: "idx_payment_attempts_payment_expiry")
  @@index([orderState, resolutionState, updatedAt], map: "idx_payment_attempts_order_resolution")
  @@map("payment_attempts")
}

model PaymentAttemptObservation {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  attemptId         String   @map("attempt_id") @db.Char(36)
  source            String   @db.VarChar(16)
  sourceKey         String   @map("source_key") @db.VarChar(255)
  payloadHash       String   @map("payload_hash") @db.Char(64)
  providerOrderCode BigInt?  @map("provider_order_code") @db.UnsignedBigInt
  providerLinkId    String?  @map("provider_link_id") @db.VarChar(255)
  expectedAmountVnd BigInt   @map("expected_amount_vnd") @db.UnsignedBigInt
  reportedAmountVnd BigInt?  @map("reported_amount_vnd") @db.UnsignedBigInt
  paidAmountVnd     BigInt?  @map("paid_amount_vnd") @db.UnsignedBigInt
  currency          String?  @db.Char(3)
  normalizedStatus  String   @map("normalized_status") @db.VarChar(32)
  verified          Boolean  @default(false) @db.TinyInt
  verifiedAt        DateTime? @map("verified_at") @db.DateTime(3)
  sanitizedReason   String?  @map("sanitized_reason") @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)

  attempt PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([attemptId, source, sourceKey, payloadHash], map: "uq_payment_attempt_observation_payload")
  @@index([attemptId, source, sourceKey], map: "idx_payment_attempt_observations_source")
  @@index([attemptId, createdAt], map: "idx_payment_attempt_observations_created")
  @@map("payment_attempt_observations")
}

model PaymentAttemptRefund {
  id                String   @id @db.Char(36)
  attemptId         String   @map("attempt_id") @db.Char(36)
  transferReference String   @unique(map: "uq_payment_attempt_refunds_transfer_reference") @map("transfer_reference") @db.VarChar(191)
  idempotencyKey    String   @unique(map: "uq_payment_attempt_refunds_idempotency") @map("idempotency_key") @db.VarChar(191)
  amountVnd         BigInt   @map("amount_vnd") @db.UnsignedBigInt
  currency          String   @default("VND") @db.Char(3)
  transferredAt     DateTime @map("transferred_at") @db.Date
  evidenceId        Int      @map("evidence_id")
  actorId           String   @map("actor_id") @db.VarChar(255)
  reason            String   @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)

  attempt  PaymentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  evidence FinancialEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor    User             @relation("PaymentAttemptRefundActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([attemptId, createdAt], map: "idx_payment_attempt_refunds_attempt_created")
  @@map("payment_attempt_refunds")
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(255)
  orderId   Int?     @map("order_id")
  category  String   @default("general") @db.VarChar(32)
  subject   String   @db.VarChar(160)
  message   String   @db.Text
  status    String   @default("OPEN") @db.VarChar(32)
  priority  String   @default("NORMAL") @db.VarChar(16)
  adminNote String?  @map("admin_note") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt], map: "support_tickets_user_created_idx")
  @@index([status, priority, createdAt], map: "support_tickets_queue_idx")
  @@map("support_tickets")
}

model AfterSalesRequest {
  manualRefundOperations ManualRefundOperation[]
  id                    Int       @id @default(autoincrement())
  orderId               Int       @map("order_id")
  userId                String?   @map("user_id") @db.VarChar(255)
  guestOrderTokenHash   String?   @map("guest_order_token_hash") @db.Char(64)
  kind                  String    @db.VarChar(16)
  status                String    @default("REQUESTED") @db.VarChar(24)
  reason                String    @db.Text
  adminNote             String?   @map("admin_note") @db.Text
  requestIdempotencyKey String    @unique(map: "after_sales_requests_idempotency_key") @map("request_idempotency_key") @db.VarChar(128)
  refundAmount          Decimal?  @map("refund_amount") @db.Decimal(14, 2)
  refundCurrency        String?   @map("refund_currency") @db.Char(3)
  refundReference       String?   @map("refund_reference") @db.VarChar(255)
  createdAt             DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.DateTime(0)
  approvedAt            DateTime? @map("approved_at") @db.DateTime(0)
  receivedAt            DateTime? @map("received_at") @db.DateTime(0)
  refundedAt            DateTime? @map("refunded_at") @db.DateTime(0)
  closedAt              DateTime? @map("closed_at") @db.DateTime(0)

  order  Order             @relation(fields: [orderId], references: [id])
  user   User?             @relation("AfterSalesRequestCustomer", fields: [userId], references: [id], onDelete: SetNull)
  items  AfterSalesItem[]
  events AfterSalesEvent[]

  @@index([orderId, status, createdAt], map: "after_sales_requests_order_status_idx")
  @@index([userId, createdAt], map: "after_sales_requests_user_created_idx")
  @@index([orderId, guestOrderTokenHash], map: "after_sales_requests_guest_order_idx")
  @@index([status, kind, createdAt], map: "after_sales_requests_queue_idx")
  @@map("after_sales_requests")
}

model AfterSalesItem {
  id          Int      @id @default(autoincrement())
  requestId   Int      @map("request_id")
  orderItemId Int      @map("order_item_id")
  quantity    Int
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)

  request   AfterSalesRequest @relation(fields: [requestId], references: [id])
  orderItem OrderItem         @relation(fields: [orderItemId], references: [id])

  @@unique([requestId, orderItemId], map: "after_sales_items_request_order_item")
  @@index([orderItemId], map: "after_sales_items_order_item_idx")
  @@map("after_sales_items")
}

model AfterSalesEvent {
  id          Int      @id @default(autoincrement())
  requestId   Int      @map("request_id")
  fromStatus  String?  @map("from_status") @db.VarChar(24)
  toStatus    String   @map("to_status") @db.VarChar(24)
  actorUserId String?  @map("actor_user_id") @db.VarChar(255)
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)

  request   AfterSalesRequest @relation(fields: [requestId], references: [id])
  actorUser User?             @relation("AfterSalesEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt], map: "after_sales_events_request_created_idx")
  @@index([actorUserId, createdAt], map: "after_sales_events_actor_created_idx")
  @@map("after_sales_events")
}
model FinancialEvidence {
  id         Int      @id @default(autoincrement())
  uploadedBy String   @map("uploaded_by") @db.VarChar(255)
  originalFilename String @map("original_filename") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  byteSize   Int      @map("byte_size") @db.UnsignedInt
  sha256     String   @db.Char(64)
  content    Bytes    @db.LongBlob
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  uploader               User                    @relation(fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  codSettlementEvents   CodSettlementEvent[]
  manualRefundOperations ManualRefundOperation[]
  paymentAttemptRefunds PaymentAttemptRefund[]

  @@index([uploadedBy], map: "financial_evidence_uploaded_by_idx")
  @@map("financial_evidence")
}

model CodSettlement {
  id              Int      @id @default(autoincrement())
  orderId         Int      @unique(map: "uq_cod_settlements_order") @map("order_id")
  expectedCodVnd  BigInt   @default(0) @map("expected_cod_vnd") @db.UnsignedBigInt
  collectedVnd    BigInt   @default(0) @map("collected_vnd") @db.UnsignedBigInt
  carrierFeeVnd   BigInt   @default(0) @map("carrier_fee_vnd") @db.UnsignedBigInt
  remittedVnd     BigInt   @default(0) @map("remitted_vnd") @db.UnsignedBigInt
  currency        String   @default("VND") @db.Char(3)
  status          String   @default("PENDING") @db.VarChar(16)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  order  Order                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events CodSettlementEvent[]

  @@map("cod_settlements")
}

model CodSettlementEvent {
  id              Int      @id @default(autoincrement())
  settlementId    Int      @map("settlement_id")
  eventType       String   @map("event_type") @db.VarChar(16)
  actorId         String?  @map("actor_id") @db.VarChar(255)
  amountVnd       BigInt   @map("amount_vnd") @db.UnsignedBigInt
  carrierFeeVnd   BigInt   @default(0) @map("carrier_fee_vnd") @db.UnsignedBigInt
  transferReference String? @unique(map: "uq_cod_settlement_transfer_reference") @map("transfer_reference") @db.VarChar(191)
  transferDate    DateTime? @map("transfer_date") @db.Date
  evidenceId      Int?     @map("evidence_id")
  previousValues  Json?    @map("previous_values")
  newValues       Json     @map("new_values")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)

  settlement CodSettlement    @relation(fields: [settlementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor      User?            @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evidence   FinancialEvidence? @relation(fields: [evidenceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([settlementId, createdAt], map: "cod_settlement_events_settlement_created_idx")
  @@index([actorId], map: "cod_settlement_events_actor_idx")
  @@map("cod_settlement_events")
}

model ManualRefundOperation {
  id               Int      @id @default(autoincrement())
  requestId        Int      @map("request_id")
  orderPaymentId   Int      @map("order_payment_id")
  actorId          String   @map("actor_id") @db.VarChar(255)
  idempotencyKey   String   @unique(map: "uq_manual_refund_idempotency") @map("idempotency_key") @db.VarChar(191)
  transferReference String  @unique(map: "uq_manual_refund_transfer_reference") @map("transfer_reference") @db.VarChar(191)
  transferDate     DateTime @map("transfer_date") @db.Date
  reviewedReason   String   @map("reviewed_reason") @db.VarChar(500)
  amountVnd        BigInt   @map("amount_vnd") @db.UnsignedBigInt
  currency         String   @default("VND") @db.Char(3)
  evidenceId       Int      @map("evidence_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)

  request     AfterSalesRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment     OrderPayment      @relation(fields: [orderPaymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor       User              @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evidence    FinancialEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  units       ManualRefundUnit[]

  @@index([requestId, createdAt], map: "manual_refund_request_created_idx")
  @@index([orderPaymentId], map: "manual_refund_payment_idx")
  @@index([actorId], map: "manual_refund_actor_idx")
  @@map("manual_refund_operations")
}

model ManualRefundUnit {
  operationId Int    @map("operation_id")
  orderItemId Int    @map("order_item_id")
  unitIndex   Int    @map("unit_index") @db.UnsignedInt
  netVnd      BigInt @map("net_vnd") @db.UnsignedBigInt

  operation ManualRefundOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItem OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([operationId, orderItemId, unitIndex])
  @@unique([orderItemId, unitIndex], map: "uq_manual_refund_order_unit")
  @@map("manual_refund_units")
}

model TransactionalEmail {
  id                         Int       @id @default(autoincrement())
  eventKey                   String    @unique(map: "uq_transactional_email_event") @map("event_key") @db.VarChar(191)
  eventType                  String    @map("event_type") @db.VarChar(40)
  recipient                  String    @db.VarChar(254)
  locale                     String    @db.VarChar(2)
  subject                    String    @db.Text
  textBody                   String    @map("text_body") @db.MediumText
  htmlBody                   String    @map("html_body") @db.MediumText
  snapshot                   Json
  contentHash                String    @map("content_hash") @db.Char(64)
  state                      String    @default("PENDING") @db.VarChar(24)
  providerMessageId          String?   @unique(map: "uq_transactional_email_provider") @map("provider_message_id") @db.VarChar(191)
  acceptedAt                 DateTime? @map("accepted_at") @db.DateTime(3)
  deliveredAt                DateTime? @map("delivered_at") @db.DateTime(3)
  bouncedAt                  DateTime? @map("bounced_at") @db.DateTime(3)
  lastErrorCode              String?   @map("last_error_code") @db.VarChar(80)
  resendOfId                 Int?      @map("resend_of_id")
  createdByAdminId           String?   @map("created_by_admin_id") @db.VarChar(255)
  unknownOutcomeAcknowledged Boolean   @default(false) @map("unknown_outcome_acknowledged")
  createdAt                  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime  @default(now()) @map("updated_at") @db.DateTime(3)

  resendOf      TransactionalEmail?  @relation("TransactionalEmailResends", fields: [resendOfId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_transactional_email_resend_of")
  resends       TransactionalEmail[] @relation("TransactionalEmailResends")
  createdByAdmin User?               @relation("TransactionalEmailAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_transactional_email_admin")
  deliveryEvents EmailDeliveryEvent[]

  @@index([state, id], map: "idx_transactional_email_state")
  @@index([resendOfId], map: "idx_transactional_email_resend_of")
  @@index([createdByAdminId], map: "idx_transactional_email_admin")
  @@map("transactional_emails")
}

model EmailDeliveryEvent {
  id                Int      @id @default(autoincrement())
  providerEventId   String   @unique(map: "uq_email_delivery_event_provider") @map("provider_event_id") @db.VarChar(191)
  emailId           Int      @map("email_id")
  providerMessageId String   @map("provider_message_id") @db.VarChar(191)
  eventType         String   @map("event_type") @db.VarChar(40)
  payloadHash       String   @map("payload_hash") @db.Char(64)
  receivedAt        DateTime @default(now()) @map("received_at") @db.DateTime(3)

  email TransactionalEmail @relation(fields: [emailId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_email_delivery_event_email")

  @@index([emailId, receivedAt], map: "idx_email_delivery_event_email")
  @@index([providerMessageId], map: "idx_email_delivery_event_message")
  @@map("email_delivery_events")
}

model AdminAuditEvent {
  id         Int      @id @default(autoincrement())
  actorId    String   @map("actor_id") @db.VarChar(255)
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.VarChar(191)
  reason     String?  @db.VarChar(500)
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([actorId, createdAt], map: "admin_audit_actor_created_idx")
  @@index([entityType, entityId, createdAt], map: "admin_audit_entity_idx")
  @@map("admin_audit_events")
}

model AdminAlertState {
  adminId   String   @map("admin_id") @db.VarChar(255)
  alertId   String   @map("alert_id") @db.VarChar(191)
  status    String   @default("ACKNOWLEDGED") @db.VarChar(16)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([adminId, alertId])
  @@index([adminId, updatedAt], map: "admin_alert_states_updated_idx")
  @@map("admin_alert_states")
}

model AdminAlertTriage {
  alertId         String    @id @map("alert_id") @db.VarChar(191)
  assignedAdminId String?   @map("assigned_admin_id") @db.VarChar(255)
  status          String    @default("OPEN") @db.VarChar(16)
  updatedBy       String    @map("updated_by") @db.VarChar(255)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  resolvedAt      DateTime? @map("resolved_at") @db.DateTime(3)

  @@index([assignedAdminId, status], map: "admin_alert_triage_owner_idx")
  @@index([status, updatedAt], map: "admin_alert_triage_status_updated_idx")
  @@map("admin_alert_triage")
}
