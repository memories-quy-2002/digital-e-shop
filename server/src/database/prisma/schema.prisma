generator client {
  provider     = "prisma-client"
  output       = "../../generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String   @id @db.VarChar(255)
  username       String   @db.VarChar(16)
  email          String   @db.VarChar(255)
  password       String   @db.VarChar(255)
  role           String   @db.VarChar(16)
  token          String   @db.Text
  authProvider   String?  @map("auth_provider") @db.VarChar(32)
  providerUserId String?  @map("provider_user_id") @db.VarChar(255)
  firstName      String?  @map("first_name") @db.Text
  lastName       String?  @map("last_name") @db.Text
  status         String   @default("Active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  lastLogin      DateTime @default(now()) @map("last_login") @db.DateTime(0)

  orders           Order[]
  carts            Cart[]
  reviews          Review[]
  pendingCheckouts PendingCheckout[]
  supportTickets   SupportTicket[]

  @@map("users")
}

model AuthSession {
  id               Int       @id @default(autoincrement())
  userId           String    @map("user_id") @db.VarChar(255)
  sessionStart     DateTime  @default(now()) @map("session_start") @db.DateTime(0)
  sessionEnd       DateTime? @map("session_end") @db.DateTime(0)
  refreshTokenHash String?   @map("refresh_token_hash") @db.Char(64)
  refreshExpiresAt DateTime? @map("refresh_expires_at") @db.DateTime(0)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(0)
  lastUsedAt       DateTime? @map("last_used_at") @db.DateTime(0)

  @@index([userId, revokedAt, refreshExpiresAt], map: "customer_sessions_user_active_idx")
  @@map("customer_sessions")
}

model Product {
  id                     Int      @id @default(autoincrement())
  name                   String   @db.VarChar(255)
  description            String   @default("No description available") @db.VarChar(255)
  mainImage              String?  @map("main_image") @db.VarChar(255)
  sku                    String   @unique(map: "uq_products_sku") @db.VarChar(64)
  manufacturerPartNumber String?  @map("manufacturer_part_number") @db.VarChar(128)
  warrantyMonths         Int?     @map("warranty_months")
  categoryId             Int      @map("category_id")
  brandId                Int      @map("brand_id")
  specifications         String?  @db.Text
  price                  Decimal  @db.Decimal(10, 2)
  salePrice              Decimal? @map("sale_price") @db.Decimal(10, 2)
  stock                  Int      @default(0)
  createdAt              DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  reviews               Review[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]
  attributes            ProductAttribute[]

  @@index([manufacturerPartNumber], map: "products_mpn_idx")
  @@map("products")
}

model ProductAttribute {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  attributeKey String   @map("attribute_key") @db.VarChar(80)
  label        String   @db.VarChar(120)
  valueType    String   @map("value_type") @db.VarChar(16)
  textValue    String?  @map("text_value") @db.VarChar(255)
  numberValue  Decimal? @map("number_value") @db.Decimal(18, 4)
  unit         String?  @db.VarChar(32)
  filterable   Boolean  @default(true) @db.TinyInt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeKey], map: "uq_product_attributes_product_key")
  @@index([attributeKey, textValue], map: "product_attributes_text_filter_idx")
  @@index([attributeKey, numberValue], map: "product_attributes_number_filter_idx")
  @@map("product_attributes")
}

model InventoryMovement {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  orderId        Int?     @map("order_id")
  movementType   String   @map("movement_type") @db.VarChar(40)
  quantityChange Int      @map("quantity_change")
  stockBefore    Int?     @map("stock_before")
  stockAfter     Int?     @map("stock_after")
  note           String?  @db.VarChar(255)
  actorId        String?  @map("actor_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([productId], map: "inventory_movements_product_id_idx")
  @@index([createdAt], map: "inventory_movements_created_at_idx")
  @@map("inventory_movements")
}

model OrderStatusEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  status    Int
  label     String   @db.VarChar(80)
  note      String?  @db.VarChar(255)
  actorId   String?  @map("actor_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([orderId], map: "order_status_events_order_id_idx")
  @@index([createdAt], map: "order_status_events_created_at_idx")
  @@map("order_status_events")
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id") @db.VarChar(255)
  productId  Int      @map("product_id")
  rating     Int
  reviewText String?  @map("review_text") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("reviews")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  done      Int      @default(0) @db.TinyInt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId], map: "uq_cart_items_carts_id_products_id")
  @@map("cart_items")
}

model Discount {
  id              Int       @id @default(autoincrement())
  discountCode    String    @map("discount_code") @db.VarChar(50)
  description     String?   @db.Text
  discountPercent Decimal   @map("discount_percent") @db.Decimal(5, 2)
  active          Boolean   @default(true) @db.TinyInt
  minOrderValue   Decimal   @default(0) @map("min_order_value") @db.Decimal(10, 2)
  startsAt        DateTime? @map("starts_at") @db.DateTime(0)
  expiresAt       DateTime? @map("expires_at") @db.DateTime(0)
  usageLimit      Int?      @map("usage_limit")

  redemptions      DiscountRedemption[]
  pendingCheckouts PendingCheckout[]

  @@unique([discountCode], map: "uq_discounts_code")
  @@map("discounts")
}

model Order {
  id                      Int       @id @default(autoincrement())
  userId                  String    @map("user_id") @db.VarChar(255)
  totalPrice              Decimal   @map("total_price") @db.Decimal(11, 2)
  discount                Decimal   @default(0) @db.Decimal(11, 2)
  shippingAddress         String    @map("shipping_address") @db.Text
  paymentMethod           String    @default("cash") @map("payment_method") @db.VarChar(32)
  stripeCheckoutSessionId String?   @unique(map: "uq_orders_stripe_checkout_session") @map("stripe_checkout_session_id") @db.VarChar(255)
  stripePaymentIntentId   String?   @map("stripe_payment_intent_id") @db.VarChar(255)
  dateAdded               DateTime  @default(now()) @map("date_added") @db.DateTime(0)
  status                  Int       @default(0)
  currency                String    @default("USD") @db.Char(3)
  inventoryRestoredAt     DateTime? @map("inventory_restored_at") @db.DateTime(0)
  cancellationReason      String?   @map("cancellation_reason") @db.Text

  user                User                 @relation(fields: [userId], references: [id])
  items               OrderItem[]
  discountRedemptions DiscountRedemption[]
  payments            OrderPayment[]
  supportTickets      SupportTicket[]

  @@map("orders")
}

model PendingCheckout {
  id               Int       @id @default(autoincrement())
  stripeSessionId  String?   @unique(map: "uq_pending_checkouts_session") @map("stripe_session_id") @db.VarChar(255)
  reservationToken String    @unique(map: "uq_pending_checkouts_reservation_token") @map("reservation_token") @db.Char(36)
  userId           String    @map("user_id") @db.VarChar(255)
  cartJson         String    @map("cart_json") @db.Text
  totalPrice       Decimal   @map("total_price") @db.Decimal(11, 2)
  discount         Decimal   @default(0) @db.Decimal(11, 2)
  shippingAddress  String    @map("shipping_address") @db.Text
  status           String    @default("PENDING") @db.VarChar(20)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(0)
  discountId       Int?      @map("discount_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  consumedAt       DateTime? @map("consumed_at") @db.DateTime(0)

  user                  User                   @relation(fields: [userId], references: [id])
  promotion             Discount?              @relation(fields: [discountId], references: [id])
  inventoryReservations InventoryReservation[]
  discountRedemptions   DiscountRedemption[]

  @@index([status, expiresAt], map: "pending_checkouts_status_expiry_idx")
  @@map("pending_checkouts")
}

model InventoryReservation {
  id                Int      @id @default(autoincrement())
  pendingCheckoutId Int      @map("pending_checkout_id")
  productId         Int      @map("product_id")
  quantity          Int
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)

  pendingCheckout PendingCheckout @relation(fields: [pendingCheckoutId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])

  @@unique([pendingCheckoutId, productId], map: "uq_inventory_reservation_checkout_product")
  @@index([productId], map: "inventory_reservations_product_idx")
  @@map("inventory_reservations")
}

model DiscountRedemption {
  id                Int       @id @default(autoincrement())
  discountId        Int       @map("discount_id")
  pendingCheckoutId Int?      @unique(map: "uq_discount_redemptions_pending_checkout") @map("pending_checkout_id")
  orderId           Int?      @unique(map: "uq_discount_redemptions_order") @map("order_id")
  userId            String    @map("user_id") @db.VarChar(255)
  status            String    @db.VarChar(20)
  expiresAt         DateTime? @map("expires_at") @db.DateTime(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  consumedAt        DateTime? @map("consumed_at") @db.DateTime(0)

  discount        Discount         @relation(fields: [discountId], references: [id])
  pendingCheckout PendingCheckout? @relation(fields: [pendingCheckoutId], references: [id])
  order           Order?           @relation(fields: [orderId], references: [id])

  @@index([discountId, status, expiresAt], map: "discount_redemptions_quota_idx")
  @@map("discount_redemptions")
}

model OrderItem {
  id                     Int      @id @default(autoincrement())
  orderId                Int      @map("order_id")
  productId              Int      @map("product_id")
  quantity               Int
  totalPrice             Decimal  @default(0) @map("total_price") @db.Decimal(11, 2)
  skuSnapshot            String?  @map("sku_snapshot") @db.VarChar(64)
  productNameSnapshot    String?  @map("product_name_snapshot") @db.VarChar(255)
  imageSnapshot          String?  @map("image_snapshot") @db.VarChar(255)
  unitPriceSnapshot      Decimal? @map("unit_price_snapshot") @db.Decimal(11, 2)
  brandSnapshot          String?  @map("brand_snapshot") @db.VarChar(255)
  categorySnapshot       String?  @map("category_snapshot") @db.VarChar(255)
  warrantyMonthsSnapshot Int?     @map("warranty_months_snapshot")
  specificationsSnapshot Json?    @map("specifications_snapshot")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId], map: "uq_order_items_order_id_product_id")
  @@map("order_items")
}

model OrderPayment {
  id                Int       @id @default(autoincrement())
  orderId           Int       @map("order_id")
  provider          String    @db.VarChar(32)
  status            String    @db.VarChar(24)
  providerReference String?   @map("provider_reference") @db.VarChar(255)
  providerPaymentId String?   @map("provider_payment_id") @db.VarChar(255)
  idempotencyKey    String    @unique(map: "uq_order_payments_idempotency") @map("idempotency_key") @db.VarChar(128)
  baseAmount        Decimal   @map("base_amount") @db.Decimal(11, 2)
  baseCurrency      String    @default("USD") @map("base_currency") @db.Char(3)
  amount            Decimal   @db.Decimal(14, 2)
  currency          String    @db.Char(3)
  fxRate            Decimal   @default(1) @map("fx_rate") @db.Decimal(18, 6)
  paidAt            DateTime? @map("paid_at") @db.DateTime(0)
  refundedAt        DateTime? @map("refunded_at") @db.DateTime(0)
  refundReference   String?   @map("refund_reference") @db.VarChar(255)
  simulated         Boolean   @default(false) @db.TinyInt
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.DateTime(0)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, status], map: "order_payments_order_status_idx")
  @@index([provider, providerReference], map: "order_payments_provider_reference_idx")
  @@map("order_payments")
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.VarChar(255)
  orderId   Int?     @map("order_id")
  category  String   @default("general") @db.VarChar(32)
  subject   String   @db.VarChar(160)
  message   String   @db.Text
  status    String   @default("OPEN") @db.VarChar(32)
  priority  String   @default("NORMAL") @db.VarChar(16)
  adminNote String?  @map("admin_note") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt], map: "support_tickets_user_created_idx")
  @@index([status, priority, createdAt], map: "support_tickets_queue_idx")
  @@map("support_tickets")
}
