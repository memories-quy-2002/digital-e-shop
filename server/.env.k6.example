# API origin (do not include /api). This default works for a local server.
BASE_URL=http://127.0.0.1:4000

# Optional local runner path when k6 is not available on PATH.
# Windows: K6_BIN="C:/Tools/k6/k6.exe"
# macOS/Linux: K6_BIN=/usr/local/bin/k6

# Optional bounded smoke profile settings.
# SMOKE_VUS=1
# SMOKE_DURATION=20s

# Bounded public catalog load: 1-5 workflows/second, 10s-5m steady duration.
# Each workflow performs four read-only API requests.
# LOAD_RATE=1
# LOAD_DURATION=2m

# Optional product override for the catalog/read-only profiles.
# PRODUCT_ID=1

# Authenticated profiles need a disposable test account. Keep its cookie in
# this ignored file or supply COOKIE through your CI secret/environment config.
# USER_ID=
# COOKIE=

# Remote targets are refused by default. Set this only for an approved,
# non-production test deployment.
# ALLOW_REMOTE_TEST_TARGET=true
