# Local Docker-only environment. Copy to .env.docker for docker:setup.
# Never use this file for production credentials.
NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3307
REDIS_PORT=6379
DB_USER=root
DB_PASSWORD=digital_e_root
DB_NAME=digital_e_shop_local
DATABASE_URL=mysql://root:digital_e_root@127.0.0.1:3307/digital_e_shop_local
REDIS_URL=redis://127.0.0.1:6379
DB_SSL=false
JWT_SECRET_KEY=digital_e_local_docker_access_secret
JWT_REFRESH_SECRET_KEY=digital_e_local_docker_refresh_secret
CSRF_SECRET=digital_e_local_docker_csrf_secret
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
PAYMENT_PROVIDER_MODE=mock
# New checkout records use whole-number VND amounts; the runtime currency is fixed to VND.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PARTNER_CODE=
PAYOS_BASE_URL=https://api-merchant.payos.vn
# Geoapify is the only supported routing provider.
DELIVERY_ROUTING_ENDPOINT_ALLOWLIST=https://api.geoapify.com/v1/routing
# OpenStreetMap standard HTTPS tile template. Follow the tile usage policy and keep attribution visible.
DELIVERY_TILE_URL_ALLOWLIST=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODING_ENDPOINT=https://api.geoapify.com/v1/geocode/search
# Geoapify server key for routing and geocoding. Restrict to these APIs; keep secret.
GEOAPIFY_API_KEY=
