# Local Docker-only environment. Copy to .env.docker for docker:setup.
# Never use this file for production credentials.
NODE_ENV=development
PORT=4000
AUTH_PROVIDER=local
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=digital_e_root
DB_NAME=digital_e_shop_local
DATABASE_URL=mysql://root:digital_e_root@127.0.0.1:3307/digital_e_shop_local
DB_SSL=false
JWT_SECRET_KEY=digital_e_local_docker_access_secret
JWT_REFRESH_SECRET_KEY=digital_e_local_docker_refresh_secret
CSRF_SECRET=digital_e_local_docker_csrf_secret
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
PAYMENT_PROVIDER_MODE=mock
PAYOS_USD_TO_VND_RATE=25000
