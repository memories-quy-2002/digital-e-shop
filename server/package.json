{
    "name": "server",
    "version": "1.0.0",
    "description": "Backend server for the e-commerce system selling electronic components and devices",
    "main": "dist/src/server.js",
    "packageManager": "pnpm@11.5.3",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "postinstall": "prisma generate --schema=src/database/prisma/schema.prisma",
        "start": "node dist/src/server.js",
        "dev": "tsc -p tsconfig.build.json && pnpm copy:assets && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --watch-path=dist dist/src/server.js\"",
        "serve:ts": "node --conditions=development --import tsx ./src/server.ts",
        "build": "prisma generate --schema=src/database/prisma/schema.prisma && tsc -p tsconfig.build.json && pnpm copy:assets",
        "vercel-build": "prisma generate --schema=src/database/prisma/schema.prisma && tsc -p tsconfig.build.json && pnpm copy:assets",
        "copy:assets": "node scripts/copy-assets.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest",
        "lint": "eslint src api --ext .js,.mjs,.cjs,.ts,.mts,.cts --format=stylish",
        "prisma": "prisma",
        "prisma:generate": "prisma generate --schema=src/database/prisma/schema.prisma",
        "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
        "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
        "prisma:migrate:status": "prisma migrate status --config prisma.config.ts",
        "prisma:migrate:resolve": "prisma migrate resolve --config prisma.config.ts",
        "seed:mock": "node src/database/seeders/seedMockOrdersReviews.js",
        "docker:up": "wsl -d Ubuntu -- bash -c \"cd /mnt/e/Code/digital-e-shop/server && docker compose --env-file .env.docker up -d\"",
        "docker:down": "wsl -d Ubuntu -- bash -c \"cd /mnt/e/Code/digital-e-shop/server && docker compose --env-file .env.docker down\"",
        "docker:import": "wsl -d Ubuntu -- bash -c \"cd /mnt/e/Code/digital-e-shop/server && grep -v GTID_PURGED src/database/migrations/defaultdb_2026-06-01_142319.sql | docker exec -i digitale-mysql mysql -uroot -pdigital_e_root defaultdb\"",
        "docker:seed": "wsl -d Ubuntu -- bash -c \"cd /mnt/e/Code/digital-e-shop/server && DB_HOST=localhost DB_PORT=3307 DB_USER=root DB_PASSWORD=digital_e_root DB_NAME=defaultdb DATABASE_URL=mysql://root:digital_e_root@localhost:3307/defaultdb MOCK_ORDER_COUNT=50 MOCK_REVIEW_COUNT=50 node src/database/seeders/seedMockOrdersReviews.js\"",
        "docker:setup": "pnpm docker:up ; pnpm docker:import ; pnpm docker:seed",
        "docs:open": "echo Open http://localhost:4000/docs in your browser",
        "perf:readonly": "k6 run test/performance-test.js",
        "perf:catalog": "k6 run test/k6-catalog-test.js",
        "perf:admin-readonly": "k6 run test/k6-admin-readonly.js",
        "perf:customer-readonly": "k6 run test/k6-customer-readonly.js",
        "perf:auth-readonly": "k6 run test/k6-auth-readonly.js"
    },
    "imports": {
        "#src/*": {
            "development": "./src/*.ts",
            "default": "./dist/src/*.js"
        }
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@prisma/adapter-mariadb": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@scalar/express-api-reference": "^0.10.8",
        "@vercel/blob": "^2.5.0",
        "axios": "^1.18.1",
        "bcryptjs": "^3.0.3",
        "body-parser": "^2.3.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "csrf-csrf": "^4.0.3",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "fs": "0.0.1-security",
        "ioredis": "^5.5.0",
        "jsonwebtoken": "^9.0.3",
        "lusca": "^1.7.0",
        "multer": "2.2.0",
        "mysql": "^2.18.1",
        "mysql2": "^3.22.5",
        "p-limit": "^7.3.0",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "path": "^0.12.7",
        "pino": "^10.3.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "sharp": "^0.35.3",
        "socks": "^2.8.9",
        "streamifier": "^0.1.1",
        "stripe": "^22.3.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/testing": "^11.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.1.0",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth20": "^2.0.16",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.4",
        "prisma": "^7.8.0",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vitest": "^4.1.9"
    }
}
