{
    "name": "server",
    "version": "1.0.0",
    "description": "Backend server for the e-commerce system selling electronic components and devices",
    "main": "dist/src/server.js",
    "packageManager": "pnpm@12.4.2",
    "engines": {
        "node": ">=24.22.1 <25"
    },
    "scripts": {
        "prepare": "cd .. && husky server/.husky",
        "postinstall": "node scripts/prisma-generate.mjs",
        "prestart": "corepack pnpm@12.4.2 prisma:prepare && corepack pnpm@12.4.2 build:compile",
        "predev": "corepack pnpm@12.4.2 prisma:generate",
        "start": "node dist/src/server.js",
        "dev": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --watch-path=dist dist/src/server.js\"",
        "serve:ts": "node --conditions=development --import tsx ./src/server.ts",
        "operations:run": "node scripts/run-operations.mjs",
        "retail:p0:sandbox": "node scripts/retail-p0-sandbox.mjs",
        "retail:p0:browser-fixture": "node scripts/prepare-retail-p0-browser.mjs",
        "build:compile": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
        "build": "corepack pnpm@12.4.2 prisma:generate && corepack pnpm@12.4.2 build:compile",
        "vercel-build": "corepack pnpm@12.4.2 build",
        "copy:assets": "node scripts/copy-assets.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "node --test docker/run.test.mjs && vitest",
        "test:integration": "vitest run --config vitest.integration.config.ts --testNamePattern=integration",
        "lint": "eslint src api --ext .js,.mjs,.cjs,.ts,.mts,.cts --max-warnings=0 --format=stylish",
        "prisma": "prisma",
        "prisma:format": "prisma format --schema=src/database/prisma/schema.prisma",
        "prisma:generate": "node scripts/prisma-generate.mjs",
        "prisma:prepare": "corepack pnpm@12.4.2 prisma:generate && corepack pnpm@12.4.2 prisma:migrate:deploy",
        "prisma:pull": "prisma db pull --config prisma.config.ts",
        "prisma:validate": "prisma validate --config prisma.config.ts",
        "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
        "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
        "prisma:migrate:status": "prisma migrate status --config prisma.config.ts",
        "prisma:migrate:resolve": "prisma migrate resolve --config prisma.config.ts",
        "prisma:seed": "prisma db seed --config prisma.config.ts",
        "seed:demo": "corepack pnpm@12.4.2 prisma:seed",
        "prisma:studio": "prisma studio --config prisma.config.ts",
        "demo:reset": "node src/database/seeders/reset-demo-database.js",
        "demo:firebase:verify": "node src/database/seeders/verify-demo-firebase.js",
        "demo:verify": "node src/database/seeders/verify-demo.js",
        "seed:delivery:local": "node src/database/seeders/seed-local-delivery-settings.js",
        "firebase:emulator": "pnpm dlx --allow-build=protobufjs --allow-build=re2 --package=firebase-tools firebase emulators:start --only auth --project demo-digital-e-local --config=../firebase.json --import=../.firebase/emulator-data --export-on-exit",
        "firebase:seed:emulator": "node src/database/seeders/seed-firebase-emulator-users.js",
        "seed:mock": "node src/database/seeders/seed-mock-orders-reviews.js",
        "docker:up": "node docker/run.mjs up",
        "docker:down": "node docker/run.mjs down",
        "docker:import": "node docker/run.mjs import",
        "docker:migrate": "node docker/run.mjs migrate",
        "docker:seed": "node docker/seed-demo-db.js",
        "docker:verify": "node docker/verify-demo-db.js",
        "docker:seed:mock": "node docker/run.mjs seed:mock",
        "docker:setup": "pnpm docker:up && pnpm docker:import && pnpm docker:migrate && pnpm docker:seed && pnpm docker:verify",
        "docs:open": "echo Open http://localhost:4000/docs in your browser",
        "perf:setup": "node scripts/setup-k6-config.mjs",
        "perf:readonly": "node scripts/run-k6.mjs readonly",
        "perf:smoke": "node scripts/run-k6.mjs smoke",
        "perf:load": "node scripts/run-k6.mjs load",
        "perf:capacity": "node scripts/run-k6.mjs capacity",
        "perf:stress": "node scripts/run-k6.mjs stress",
        "perf:catalog": "node scripts/run-k6.mjs catalog",
        "perf:admin-readonly": "node scripts/run-k6.mjs admin-readonly",
        "perf:customer-readonly": "node scripts/run-k6.mjs customer-readonly",
        "perf:auth-readonly": "node scripts/run-k6.mjs auth-readonly"
    },
    "imports": {
        "#src/*": {
            "development": "./src/*.ts",
            "default": "./dist/src/*.js"
        }
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@nestjs/common": "^11.2.3",
        "@nestjs/core": "^11.2.3",
        "@nestjs/platform-express": "^11.2.3",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
        "@opentelemetry/instrumentation-express": "^0.71.1",
        "@opentelemetry/instrumentation-http": "^0.223.0",
        "@opentelemetry/instrumentation-mysql2": "^0.69.0",
        "@opentelemetry/resources": "^2.12.0",
        "@opentelemetry/sdk-metrics": "^2.11.0",
        "@opentelemetry/sdk-node": "^0.223.0",
        "@payos/node": "^2.0.5",
        "@prisma/adapter-mariadb": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "@scalar/express-api-reference": "^0.10.29",
        "@vercel/blob": "^2.8.2",
        "axios": "^1.20.0",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "csrf-csrf": "^4.0.3",
        "dotenv": "^17.4.2",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "firebase-admin": "^14.5.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "2.4.0",
        "mysql2": "^3.24.6",
        "pino": "^10.4.0",
        "reflect-metadata": "^0.2.2",
        "resend": "6.33.0",
        "rxjs": "^7.8.2",
        "sharp": "^0.35.5",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@nestjs/testing": "^11.2.3",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-serve-static-core": "^5.1.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.5",
        "concurrently": "^10.0.6",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "husky": "9.1.7",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.9.10",
        "prisma": "^7.10.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.5"
    }
}
