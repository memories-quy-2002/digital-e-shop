# ── Server Environment ────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env files.

# ── Node ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── MySQL Database (Aiven Cloud remote or local Docker) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=digital_e
DATABASE_URL=mysql://root:your_mysql_password@localhost:3306/digital_e

# ── JWT Auth ─────────────────────────────────────────────
JWT_SECRET_KEY=your_jwt_access_secret
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret
CSRF_SECRET=your_csrf_secret

# ── Client & Server URLs ─────────────────────────────────
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/users/auth/google/callback

# ── Vercel Blob Storage ──────────────────────────────────
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# ── Redis (optional, for response caching) ──────────────
REDIS_URL=redis://localhost:6379

# ── Search API (optional) ────────────────────────────────
SEARCHAPI_KEY=your_searchapi_key

# ── DB Debugging ─────────────────────────────────────────
DB_QUERY_LOG=false
DB_QUERY_LOG_THRESHOLD_MS=200
DB_EXPLAIN_SLOW=false

# ── Mock Seed Counts ─────────────────────────────────────
MOCK_ORDER_COUNT=20
MOCK_REVIEW_COUNT=20
