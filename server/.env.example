# Server Environment
# Copy this file to .env and fill in any optional values.
# Never commit .env files.
# This template is for ordinary local server commands. Docker uses
# .env.docker.example. Production values belong in Vercel/GitHub environment settings.
# Production startup requires explicit database, auth, and origin variables;
# it does not use the local defaults below.

# Node
NODE_ENV=development
PORT=4000

# Local MySQL Database (Docker only)
# Local Docker only. Do not replace these values with a production database.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=digital_e_root
DB_NAME=digital_e_shop_local
DATABASE_URL=mysql://root:digital_e_root@127.0.0.1:3307/digital_e_shop_local
DB_SSL=false

# JWT Auth
JWT_SECRET_KEY=your_jwt_access_secret
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret
CSRF_SECRET=your_csrf_secret

# Firebase Admin Auth
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Set this only for local Firebase Auth Emulator testing. Do not use in production.
FIREBASE_AUTH_EMULATOR_HOST=

# Client and Server URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Payments
PAYMENT_PROVIDER_MODE=mock
# New checkout records use whole-number VND amounts; the runtime currency is fixed to VND.
# Required only when PAYMENT_PROVIDER_MODE=live. Keep these server-side.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn

# DB Debugging
DB_QUERY_LOG=false
DB_QUERY_LOG_THRESHOLD_MS=200
DB_EXPLAIN_SLOW=false

# Mock Seed Counts
MOCK_ORDER_COUNT=20
MOCK_REVIEW_COUNT=20
