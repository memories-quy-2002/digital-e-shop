# ── Server Environment ────────────────────────────────────
# Copy this file to .env.local and fill in any optional values.
# Never commit .env files.
# This template is for local Docker only. Production values belong in
# Vercel/GitHub environment settings.
# Production startup requires explicit database, auth, and origin variables;
# it does not use the local defaults below.

# ── Node ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
AUTH_PROVIDER=local

# ── Local MySQL Database (Docker only) ───────────────────
# Local Docker only. Do not replace these values with a production database.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=digital_e_root
DB_NAME=digital_e_shop_local
DATABASE_URL=mysql://root:digital_e_root@127.0.0.1:3307/digital_e_shop_local
DB_SSL=false

# ── JWT Auth ─────────────────────────────────────────────
JWT_SECRET_KEY=your_jwt_access_secret
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret
CSRF_SECRET=your_csrf_secret

# ── Firebase Admin Auth ──────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Client & Server URLs ─────────────────────────────────
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/users/auth/google/callback

# ── Vercel Blob Storage ──────────────────────────────────
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# ── Search API (optional) ────────────────────────────────
SEARCHAPI_KEY=your_searchapi_key

# ── Stripe ───────────────────────────────────────────────
# Server-side secret key. Test mode keys start with sk_test_, live keys with sk_live_.
# Get it from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Webhook signing secret. Get it from https://dashboard.stripe.com/webhooks
# (use the CLI `stripe listen --forward-to http://localhost:4000/api/orders/webhooks/stripe`
#  secret during local development — it starts with whsec_).
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
PAYMENT_PROVIDER_MODE=mock
PAYOS_USD_TO_VND_RATE=25000

# ── Distributed Rate Limiting (optional locally) ─────────
# Required in production when rate limits must be shared across instances.
REDIS_URL=

# ── DB Debugging ─────────────────────────────────────────
DB_QUERY_LOG=false
DB_QUERY_LOG_THRESHOLD_MS=200
DB_EXPLAIN_SLOW=false

# ── Mock Seed Counts ─────────────────────────────────────
MOCK_ORDER_COUNT=20
MOCK_REVIEW_COUNT=20
