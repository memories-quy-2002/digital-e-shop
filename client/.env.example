# Vite client environment.
# Do not include /api here; request modules add that path themselves.
VITE_API_BASE_URL=http://localhost:4000


# Local Firebase Auth Emulator profile.
# VITE_FIREBASE_PROJECT_ID=demo-digital-e-local
# VITE_FIREBASE_API_KEY=demo-api-key
# VITE_FIREBASE_AUTH_DOMAIN=demo-digital-e-local.firebaseapp.com
# VITE_FIREBASE_STORAGE_BUCKET=demo-digital-e-local.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# VITE_FIREBASE_APP_ID=1:000000000000:web:demo-digital-e-local
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Production/Vercel client build variables. VITE_* values are included in the
# browser bundle. Firebase web configuration is public, not server credentials;
# restrict the Firebase API key to the APIs and origins used by this app.
# Set these in the Vercel Production environment. Do not set the emulator URL.
# VITE_API_BASE_URL=https://<production-api-host>
# VITE_FIREBASE_PROJECT_ID=<production-project-id>
# VITE_FIREBASE_API_KEY=<production-firebase-web-api-key>
# VITE_FIREBASE_AUTH_DOMAIN=<production-project>.firebaseapp.com
# VITE_FIREBASE_STORAGE_BUCKET=<production-bucket-from-firebase-console>
# VITE_FIREBASE_MESSAGING_SENDER_ID=<production-sender-id>
# VITE_FIREBASE_APP_ID=<production-web-app-id>
# VITE_FIREBASE_MEASUREMENT_ID=<optional-measurement-id>
# VITE_FIREBASE_AUTH_EMULATOR_URL is development-only and must be absent in production.
