{
    "name": "client",
    "version": "1.0.0",
    "description": "A e-commerce system selling electronic components and devices",
    "packageManager": "pnpm@11.5.3",
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/user-event": "^14.6.5",
        "@types/node": "^26.2.0",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "axios": "^1.19.0",
        "firebase": "^12.18.0",
        "jest-environment-jsdom": "^30.4.1",
        "js-cookie": "^3.0.8",
        "react": "^19.2.8",
        "react-bootstrap": "^2.10.10",
        "react-dom": "^19.2.8",
        "react-helmet": "^6.1.0",
        "react-input-slider": "^6.0.1",
        "react-lazy-load-image-component": "^1.6.3",
        "react-paginate": "^8.3.0",
        "react-router-dom": "^7.18.2",
        "react-slider": "^2.0.6",
        "recharts": "^3.10.1",
        "sass": "^1.103.1",
        "scss": "^0.2.4",
        "universal-cookie": "^8.1.2",
        "web-vitals": "^5.3.0"
    },
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "lint": "eslint src --ext .js,.mjs,.cjs,.ts,.mts,.cts,.jsx,.tsx --format=pretty",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "preview": "vite preview"
    },
    "jest": {
        "transform": {
            "^.+\\.jsx?$": "babel-jest",
            "^.+\\.tsx?$": "ts-jest"
        },
        "moduleNameMapper": {
            "^axios$": "axios/dist/node/axios.cjs"
        }
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-react": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/react-helmet": "^6.1.11",
        "@types/react-slider": "^1.3.6",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitest/ui": "4.1.11",
        "babel-jest": "^30.4.1",
        "eslint": "^10.8.1",
        "eslint-formatter-pretty": "^7.1.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.11.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^30.4.2",
        "jiti": "^2.7.0",
        "jsdom": "^29.1.1",
        "node-fetch": "^3.3.2",
        "prettier": "^3.9.6",
        "ts-jest": "^29.4.12",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "webpack-bundle-analyzer": "^5.3.1"
    }
}
