{
    "name": "client",
    "version": "1.0.0",
    "description": "A e-commerce system selling electronic components and devices",
    "packageManager": "pnpm@12.4.2",
    "engines": {
        "node": ">=24.22.1 <25"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.3.1",
        "@types/node": "^26.6.6",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.1.0",
        "axios": "^1.21.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "firebase": "^12.19.0",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.69.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-helmet-async": "^3.0.0",
        "react-paginate": "^8.3.0",
        "react-router-dom": "^7.18.5",
        "recharts": "^3.10.1",
        "sass": "^1.107.1",
        "tailwind-merge": "^3.7.0",
        "universal-cookie": "^8.1.2"
    },
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build": "node scripts/build.mjs",
        "analyze": "node scripts/build.mjs --analyze",
        "lint": "eslint src --ext .js,.mjs,.cjs,.ts,.mts,.cts,.jsx,.tsx --max-warnings=0 --format=pretty",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:e2e": "playwright test e2e/retail-p0.spec.ts",
        "preview": "vite preview",
        "format": "prettier . --write --ignore-path ../.prettierignore",
        "format:check": "prettier . --check --ignore-path ../.prettierignore"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.3.4",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/leaflet": "^1.9.22",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/ui": "5.1.0",
        "eslint": "^10.14.0",
        "eslint-formatter-pretty": "^7.1.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "jiti": "^2.7.0",
        "jsdom": "^30.1.3",
        "node-fetch": "^3.3.2",
        "prettier": "^3.9.10",
        "rollup-plugin-visualizer": "^7.1.2",
        "tailwindcss": "^4.3.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
